# App and realtime ports
WEB_PORT=10000
REALTIME_PORT=10001
NEXT_PUBLIC_WEB_PORT=10000
NEXT_PUBLIC_REALTIME_PORT=10001

# pnpm dev detects this Mac's <LocalHostName>.local automatically.
# Set this only when the certificate hostname must be overridden.
# NEXT_PUBLIC_DEV_HOSTNAME=my-mac.local

# Optional public origins. When omitted, clients use the current page hostname.
# NEXT_PUBLIC_APP_URL=https://app.example.org
# NEXT_PUBLIC_REALTIME_URL=https://realtime.example.org

# Comma-separated exact origins for internet-facing use. Local development
# permits the generated HTTPS app origin when this is empty.
# REALTIME_ALLOWED_ORIGINS=https://example.org

# WebRTC ICE servers. STUN is enough for many same-LAN rehearsals; TURN is
# required for dependable cross-network broadcasting.
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"},{"urls":"turns:turn.example.org:5349","username":"user","credential":"secret"}]
