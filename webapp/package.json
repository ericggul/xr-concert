{
  "name": "nrf-xr-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x || 26.x"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev-https.mjs",
    "dev:web": "bash scripts/generate-certs.sh && next dev --hostname 0.0.0.0 --port ${WEB_PORT:-10000} --experimental-https --experimental-https-key certificates/server.key --experimental-https-cert certificates/server.pem --experimental-https-ca certificates/rootCA.pem",
    "dev:realtime": "bash scripts/generate-certs.sh && node realtime-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"realtime/**/*.test.mjs\"",
    "test:load": "node tests/load/realtime-load.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "next": "16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  }
}
